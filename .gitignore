# Results
# Ignore checkpoints EXCEPT the LBA-finetuned one: it is the artifact behind
# experiment 3's forgetting result, and at 27 MB it is small enough to version
# alongside the figures it produced. Same structure as the figures block below --
# a negation cannot re-include a path whose parent directory is excluded, so every
# parent level is unignored and its other children re-ignored in turn.
outputs/checkpoints/*
!outputs/checkpoints/model_class/
outputs/checkpoints/model_class/*
!outputs/checkpoints/model_class/cf/
outputs/checkpoints/model_class/cf/*
!outputs/checkpoints/model_class/cf/lba_finetune/
outputs/checkpoints/model_class/cf/lba_finetune/*
!outputs/checkpoints/model_class/cf/lba_finetune/*.pt
# Keep the shared benchmark test set (e1_data): every arm is scored on these exact
# files and a regeneration does not reproduce them, so they travel with the repo.
outputs/data/*
!outputs/data/benchmark/
outputs/data/benchmark/*
!outputs/data/benchmark/seed0/
outputs/timing/
outputs/logs/
# Ignore figures except real_data and model_class/cf. A negation cannot
# re-include a path whose parent directory is excluded, so the model_class
# parent must be unignored first and its other children re-ignored.
outputs/figures/*
!outputs/figures/real_data
!outputs/figures/encoder_rep
!outputs/figures/model_class/
outputs/figures/model_class/*
!outputs/figures/model_class/cf
outputs/figures/model_class/cf/**/*.npz

# .claude: skills are SHARED across hosts (tracked); settings.local.json is machine-local.
.claude/*
!.claude/skills/
.claude/settings.local.json

wandb/

# Datasets
datasets/
*.npz
# encoder_rep results are small and are the experiment's record — keep them.
# Must come AFTER the global *.npz rule: last matching pattern wins.
!outputs/figures/encoder_rep/**/*.npz
!outputs/data/benchmark/seed0/*.npz

# Vendored typeface. The TTFs are ~2 MB of binary that never changes and is not
# ours; `fetch_fonts.sh` pulls the pinned release into cogformer/utils/fonts/.
# The LICENSE stays tracked: it records the terms and the exact version a
# checkout is meant to fetch, which is the part that has to survive in git.
cogformer/utils/fonts/*.ttf
cogformer/utils/fonts/*.otf

# macOS Finder metadata
.DS_Store

# Study roots (experiments/setup_study.sh) mirror the whole tree one level down, at
# outputs/<study>/outputs/..., where the anchored rules above do not reach -- that is
# how the gaussian-softmax study's checkpoints and PPC caches (1.1 GB) got staged.
# A study's results live in its finals/, figures/ and evaluations/; its checkpoints
# and data stay local.
outputs/*/outputs/checkpoints/
outputs/*/outputs/data/
outputs/*/outputs/timing/
outputs/*/outputs/logs/
outputs/*/superseded_copies_of_main/

# Safety net for any other path: model weights and pickled caches never go to git.
# The one deliberate exception (the LBA-finetuned checkpoint, see "Results") is
# re-stated after it, since the last matching pattern wins.
*.pt
*.pth
*.ckpt
*.keras
*.h5
*.pkl
!outputs/checkpoints/model_class/cf/lba_finetune/*.pt
